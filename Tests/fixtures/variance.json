  "kind": "math",
  "latex": "\\begin{aligned} \\operatorname{Var}(X) &= \\mathbb{E}\\left[(X - \\mathbb{E}[X])^2\\right] \\\\ &= \\mathbb{E}\\left[X^2 - 2X\\,\\mathbb{E}[X] + \\mathbb{E}[X]^2\\right] \\\\ &= \\mathbb{E}[X^2] - 2\\,\\mathbb{E}[X]\\,\\mathbb{E}[X] + \\mathbb{E}[X]^2 \\\\ &= \\mathbb{E}[X^2] - \\mathbb{E}[X]^2 \\end{aligned}"
