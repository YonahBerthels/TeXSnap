# Build output (the app, SwiftPM's cache, the packaged model for the GitHub release)
/build/
/.build/
/.swiftpm/
*.xcodeproj/xcuserdata/

# Training: Python env, downloaded sources, generated images, runs, benchmark outputs
/ml/.venv/
/ml/data/
/ml/runs/
/ml/results/
__pycache__/
*.pyc

# Models belong in the GitHub release, never in git
*.safetensors
*.gguf
*.zip

# Secrets: API keys live in the macOS keychain; keep any local env files out
.env
.env.*
*.pem
*.p12
*.key
*.mobileprovision

# macOS
.DS_Store
